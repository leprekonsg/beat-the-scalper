# BTS runtime configuration. Copy to .env and edit. Never commit .env.
BTS_MODE=demo
# Model provider for extraction/interpretation. Default is anthropic (claude-opus-5, see
# ANTHROPIC_MODEL below). Set to "gemini" to use gemini-3.8-flash as a faster/cheaper
# alternative path; it does not run the browser toolset (no tool-using tasks).
BTS_MODEL_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Optional: Gemini fast path. Interactions are never stored server-side (store is always
# false); each task is a fresh, bounded call, same as the Anthropic path.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# low|medium|high. "low" is the speed choice for the fast path; gemini-3.8-flash rejects "minimal".
BTS_GEMINI_THINKING_LEVEL=low
BTS_AGENT_EFFORT=high
BTS_TIMEZONE=Asia/Singapore
# Live Lazada access stays disabled until docs/lazada-feasibility.md records a passed gate.
BTS_LIVE_OBSERVE_ENABLED=false
BTS_LIVE_PREPARE_ENABLED=false
# Live cadence has no default. Leave empty unless a reviewed MonitorPolicy exists.
BTS_BASELINE_INTERVAL_SECONDS=
BTS_PRIORITY_INTERVAL_SECONDS=
BTS_AGENT_MAX_TOOL_CALLS=20
BTS_AGENT_MAX_SECONDS=120
BTS_SHOW_MODEL_UPDATES=false
# Local ports. Demo storefront and presenter controls are separate origins.
BTS_API_PORT=4300
BTS_UI_PORT=5173
BTS_DEMO_STORE_PORT=4310
BTS_DEMO_ADMIN_PORT=4311
# Local data paths (gitignored).
BTS_DATA_DIR=./data

# Optional accelerated demo clock (UTC instant). 2026-09-18T04:58:00.000Z is 12:58 Asia/Singapore.
# BTS_VIRTUAL_CLOCK_START=

# Only for "npm run test:live:lazada" (tests/live/lazada-gemini-computer-use.spec.ts). Live
# access is never automatic: the test skips itself unless both are set (plus GEMINI_API_KEY
# above) for this run. BTS_LIVE_LAZADA_APPROVED is the per-run approval record (who granted
# permission and when), not a standing grant.
# BTS_LIVE_LAZADA_URL=
# BTS_LIVE_LAZADA_APPROVED=
